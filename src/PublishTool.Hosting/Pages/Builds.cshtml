@page
@model BuildsModel
@{
    ViewData["Title"] = "All Builds";
}

<div class="pt-header">
    <div class="container pt-header-row">
        <div>
            <h1>All Builds</h1>
            <p>Every build published by the team, across every project.</p>
        </div>
        <div class="pt-actions">
            <a href="/" class="pt-btn pt-btn-ghost">&larr; Projects</a>
            <a href="/UploadBuild" class="pt-btn pt-btn-ghost">Upload build files</a>
            <a href="/Upload" class="pt-btn pt-btn-primary">Upload a build</a>
        </div>
    </div>
</div>

<div class="pt-page">
    @if (Model.BuildsRootNotConfigured)
    {
        <div class="pt-alert">
            <strong>Builds root is not configured.</strong>
            Set <code>BuildsRoot</code> in appsettings.json (or a <code>BuildsRoot</code> environment
            variable, e.g. via web.config's <code>&lt;aspNetCore&gt;&lt;environmentVariables&gt;</code>)
            to the same path PublishTool's publisher archives builds to. Editing appsettings.json
            directly on the deployed site will be overwritten the next time this site is republished --
            prefer setting it in the source file or via web.config's environment variable instead.
        </div>
    }
    else if (Model.BuildsRootNotAccessible)
    {
        <div class="pt-alert">
            <strong>Builds root <code>@Model.BuildsRootPath</code> doesn't exist, or this process can't see it.</strong>
            This site is currently running as <code>@Model.RunningAs</code>. If that path exists and is
            readable from wherever you published it, this is very often an IIS Application Pool identity
            permission problem: the app pool's identity (often <code>ApplicationPoolIdentity</code>) can't
            read another user's <code>%APPDATA%</code> folder. Either grant that identity read access to
            <code>@Model.BuildsRootPath</code>, or (recommended) move the build repository to a location
            every relevant identity can read, such as <code>C:\ProgramData\PublishTool\Builds</code> or a
            shared network path -- and point both PublishTool's Settings and this site's <code>BuildsRoot</code>
            at the same new location.
        </div>
    }
    else
    {
        <div class="pt-card">
            @await Html.PartialAsync("_BuildsTable", Model.Table)
        </div>
    }

    <div class="pt-footer">Build Archive</div>
</div>

@section Scripts {
    <script src="~/js/builds-table.js"></script>
    <script>
        var releaseNotesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Table?.ReleaseNotesByPath ?? new Dictionary<string, PublishTool.Hosting.ReleaseNotesModalEntry>()));
        PublishToolBuildsTable.init(releaseNotesData);
    </script>
}

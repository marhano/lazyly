@page
@model IndexModel
@{
    ViewData["Title"] = "Builds";
}

<div class="pt-header">
    <div class="container pt-header-row">
        <div>
            <h1>Build Archive</h1>
            <p>Browse and download builds published by the team.</p>
        </div>
        <div class="pt-actions">
            <a href="/UploadBuild" class="pt-btn pt-btn-ghost">Upload build files</a>
            <a href="/Upload" class="pt-btn pt-btn-primary">Upload a build</a>
        </div>
    </div>
</div>

<div class="pt-page">
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="pt-alert pt-alert-success">@statusMessage</div>
    }

    @if (Model.BuildsRootNotConfigured)
    {
        <div class="pt-alert">
            <strong>Builds root is not configured.</strong>
            Set <code>BuildsRoot</code> in appsettings.json (or a <code>BuildsRoot</code> environment
            variable, e.g. via web.config's <code>&lt;aspNetCore&gt;&lt;environmentVariables&gt;</code>)
            to the same path PublishTool's publisher archives builds to. Editing appsettings.json
            directly on the deployed site will be overwritten the next time this site is republished --
            prefer setting it in the source file or via web.config's environment variable instead.
        </div>
    }
    else if (Model.BuildsRootNotAccessible)
    {
        <div class="pt-alert">
            <strong>Builds root <code>@Model.BuildsRootPath</code> doesn't exist, or this process can't see it.</strong>
            This site is currently running as <code>@Model.RunningAs</code>. If that path exists and is
            readable from wherever you published it, this is very often an IIS Application Pool identity
            permission problem: the app pool's identity (often <code>ApplicationPoolIdentity</code>) can't
            read another user's <code>%APPDATA%</code> folder. Either grant that identity read access to
            <code>@Model.BuildsRootPath</code>, or (recommended) move the build repository to a location
            every relevant identity can read, such as <code>C:\ProgramData\PublishTool\Builds</code> or a
            shared network path -- and point both PublishTool's Settings and this site's <code>BuildsRoot</code>
            at the same new location.
        </div>
    }
    else if (Model.Projects.Count == 0)
    {
        <div class="pt-card">
            <p class="pt-muted" style="margin: 0;">No builds found yet.</p>
        </div>
    }
    else
    {
        <div class="pt-projects-grid">
            @foreach (var project in Model.Projects)
            {
                <a class="pt-project-card" href="/Project/@Uri.EscapeDataString(project.Name)">
                    <div class="pt-project-card-header">
                        <h3>@project.Name</h3>
                        @if (project.MostRecentBuild!.IsLatest)
                        {
                            <span class="pt-badge-latest">latest</span>
                        }
                    </div>
                    <div class="pt-project-card-body">
                        <span class="pt-version">@project.MostRecentBuild!.Version</span>
                        <span class="pt-muted">@project.MostRecentBuild!.PublishedAtUtc.ToPhTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                    </div>
                    <div class="pt-project-card-footer pt-muted">
                        @project.BuildCount build@(project.BuildCount == 1 ? "" : "s") &middot; by @project.MostRecentBuild!.PublishedBy
                    </div>
                </a>
            }
        </div>

        <div class="pt-section-header">
            <h2>Recent builds</h2>
            <a href="/Builds" class="pt-btn pt-btn-ghost pt-btn-sm">View all</a>
        </div>

        <div class="pt-card">
            @if (Model.RecentBuilds is null || Model.RecentBuilds.Builds.Count == 0)
            {
                <p class="pt-muted" style="margin: 0;">No builds found yet.</p>
            }
            else
            {
                <div class="pt-table-wrap">
                    <table class="pt-table">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Version</th>
                                <th>Published</th>
                                <th>By</th>
                                <th>Size</th>
                                <th>&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var build in Model.RecentBuilds.Builds)
                            {
                                <tr>
                                    <td><a href="/Project/@Uri.EscapeDataString(build.ProjectName)">@build.ProjectName</a></td>
                                    <td>
                                        <span class="pt-version">@build.Version</span>
                                        @if (build.IsLatest)
                                        {
                                            <span class="pt-badge-latest">latest</span>
                                        }
                                    </td>
                                    <td class="pt-muted">@build.PublishedAtUtc.ToPhTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                    <td class="pt-muted">@build.PublishedBy</td>
                                    <td class="pt-num">@BuildDisplayHelpers.FormatFileSize(build.ZipPath)</td>
                                    <td>
                                        <div class="pt-actions">
                                            @if (BuildDisplayHelpers.HasReleaseNotes(build))
                                            {
                                                <button type="button" class="pt-btn pt-btn-ghost pt-btn-sm pt-view-notes"
                                                        data-notes-key="@BuildDisplayHelpers.RelativeReleaseNotesPath(Model.BuildsRootPath, build)">
                                                    Release Notes
                                                </button>
                                            }
                                            <a class="pt-btn pt-btn-primary pt-btn-sm"
                                               href="/download?path=@Uri.EscapeDataString(BuildDisplayHelpers.RelativeZipPath(Model.BuildsRootPath, build))">
                                                Download
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @await Html.PartialAsync("_ReleaseNotesModal")
    }

    <div class="pt-footer">Build Archive</div>
</div>

@section Scripts {
    <script src="~/js/builds-table.js"></script>
    <script>
        var releaseNotesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentBuilds?.ReleaseNotesByPath ?? new Dictionary<string, PublishTool.Hosting.ReleaseNotesModalEntry>()));
        PublishToolBuildsTable.init(releaseNotesData);
    </script>
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Builds";
}

<div class="pt-header">
    <div class="container pt-header-row">
        <div>
            <h1>Build Archive</h1>
            <p>Browse and download builds published by the team.</p>
        </div>
        <div class="pt-actions">
            <a href="/UploadBuild" class="pt-btn pt-btn-ghost">Upload build files</a>
            <a href="/Upload" class="pt-btn pt-btn-primary">Upload a build</a>
        </div>
    </div>
</div>

<div class="pt-page">
    @if (TempData["UploadSuccessMessage"] is string uploadSuccessMessage)
    {
        <div class="pt-alert pt-alert-success">@uploadSuccessMessage</div>
    }

    @if (Model.BuildsRootNotConfigured)
    {
        <div class="pt-alert">
            <strong>Builds root is not configured.</strong>
            Set <code>BuildsRoot</code> in appsettings.json (or a <code>BuildsRoot</code> environment
            variable, e.g. via web.config's <code>&lt;aspNetCore&gt;&lt;environmentVariables&gt;</code>)
            to the same path PublishTool's publisher archives builds to. Editing appsettings.json
            directly on the deployed site will be overwritten the next time this site is republished --
            prefer setting it in the source file or via web.config's environment variable instead.
        </div>
    }
    else if (Model.BuildsRootNotAccessible)
    {
        <div class="pt-alert">
            <strong>Builds root <code>@Model.BuildsRootPath</code> doesn't exist, or this process can't see it.</strong>
            This site is currently running as <code>@Model.RunningAs</code>. If that path exists and is
            readable from wherever you published it, this is very often an IIS Application Pool identity
            permission problem: the app pool's identity (often <code>ApplicationPoolIdentity</code>) can't
            read another user's <code>%APPDATA%</code> folder. Either grant that identity read access to
            <code>@Model.BuildsRootPath</code>, or (recommended) move the build repository to a location
            every relevant identity can read, such as <code>C:\ProgramData\PublishTool\Builds</code> or a
            shared network path -- and point both PublishTool's Settings and this site's <code>BuildsRoot</code>
            at the same new location.
        </div>
    }
    else
    {
        <div class="pt-card">
            @if (Model.Builds.Count == 0)
            {
                <p class="pt-muted" style="margin: 0;">No builds found yet.</p>
            }
            else
            {
                <div class="pt-filter-bar">
                    <label for="projectFilter">Project</label>
                    <select id="projectFilter" class="pt-input">
                        <option value="">All projects</option>
                        @foreach (var name in Model.ProjectNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>

                <div class="pt-table-wrap">
                    <table id="buildsTable" class="pt-table">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Version</th>
                                <th>Published</th>
                                <th>By</th>
                                <th>Size</th>
                                <th>&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var build in Model.Builds)
                            {
                                <tr>
                                    <td>@build.ProjectName</td>
                                    <td>
                                        <span class="pt-version">@build.Version</span>
                                        @if (build.IsLatest)
                                        {
                                            <span class="pt-badge-latest">latest</span>
                                        }
                                    </td>
                                    <td class="pt-muted" data-sort="@build.PublishedAtUtc.ToUnixTimeSeconds()">@build.PublishedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="pt-muted">@build.PublishedBy</td>
                                    <td class="pt-num" data-sort="@IndexModel.GetFileSizeBytes(build.ZipPath)">@IndexModel.FormatFileSize(build.ZipPath)</td>
                                    <td>
                                        <div class="pt-actions">
                                            @if (Model.HasReleaseNotes(build))
                                            {
                                                <button type="button" class="pt-btn pt-btn-ghost pt-btn-sm pt-view-notes"
                                                        data-notes-key="@Model.RelativeReleaseNotesPath(build)">
                                                    Release Notes
                                                </button>
                                            }
                                            <a class="pt-btn pt-btn-primary pt-btn-sm"
                                               href="/download?path=@Uri.EscapeDataString(Model.RelativeZipPath(build))">
                                                Download
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="pt-footer">Build Archive</div>
</div>

<div id="releaseNotesModal" class="pt-modal-overlay" hidden>
    <div class="pt-modal">
        <div class="pt-modal-header">
            <h2 id="releaseNotesModalTitle">Release Notes</h2>
            <button type="button" class="pt-modal-close" id="releaseNotesModalClose" aria-label="Close">&times;</button>
        </div>
        <div class="pt-modal-body">
            <pre id="releaseNotesModalContent"></pre>
        </div>
        <div class="pt-modal-footer">
            <a id="releaseNotesModalDownload" class="pt-btn pt-btn-primary pt-btn-sm" href="#">Download .txt</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var releaseNotesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReleaseNotesByPath));

        $(function () {
            var buildsTable = $('#buildsTable').DataTable({
                order: [[2, 'desc']],
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                columnDefs: [{ orderable: false, targets: 5 }],
                language: {
                    search: 'Search:',
                    info: 'Showing _START_-_END_ of _TOTAL_ builds',
                    infoEmpty: 'No builds to show',
                    infoFiltered: '(filtered from _MAX_ total)',
                    emptyTable: 'No builds match your search.',
                    lengthMenu: 'Show _MENU_ per page',
                },
            });

            // Exact-match filter on the Project column, separate from the free-text search box --
            // a plain column().search() would treat the project name as a regex/substring pattern,
            // which breaks for names containing regex-special characters (parentheses, dots, etc.)
            // and would also match "OmniPay" against a project literally named "OmniPay Business".
            $('#projectFilter').on('change', function () {
                var selected = this.value;
                buildsTable.column(0).search(selected ? '^' + $.fn.dataTable.util.escapeRegex(selected) + '$' : '', true, false).draw();
            });

            var $overlay = $('#releaseNotesModal');
            var $title = $('#releaseNotesModalTitle');
            var $content = $('#releaseNotesModalContent');
            var $download = $('#releaseNotesModalDownload');

            function openModal(key) {
                var entry = releaseNotesData[key];
                if (!entry) {
                    return;
                }

                $title.text(entry.Title);
                $content.text(entry.Text);
                $download.attr('href', '/download?path=' + encodeURIComponent(key));
                $overlay.removeAttr('hidden');
            }

            function closeModal() {
                $overlay.attr('hidden', true);
            }

            // Delegated on the table itself (not the buttons) so this keeps working across
            // DataTables' pagination, which swaps tbody rows in and out of the DOM.
            $('#buildsTable').on('click', '.pt-view-notes', function () {
                openModal($(this).data('notes-key'));
            });

            $('#releaseNotesModalClose').on('click', closeModal);
            $overlay.on('click', function (e) {
                if (e.target === this) {
                    closeModal();
                }
            });
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeModal();
                }
            });
        });
    </script>
}

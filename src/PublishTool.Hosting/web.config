<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked into source so `dotnet publish` merges into (rather than replaces) the auto-generated
  web.config: the aspNetCore attributes below get overwritten with SDK-computed values at
  publish time, but the security section is preserved.

  maxAllowedContentLength is IIS's own request-filtering limit, enforced before the request ever
  reaches ASP.NET Core: raising Program.cs's MaxUploadBytes alone isn't enough when deployed
  under IIS. Keep this in bytes, roughly matching appsettings.json's MaxUploadBytes.

  NOTE: XML comments cannot contain two consecutive hyphens anywhere in their body. If this
  comment fails to parse, dotnet publish silently discards this whole file and generates a bare
  one instead, which is exactly the bug that necessitated this note. Proofread any edit here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PublishTool.Hosting.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>

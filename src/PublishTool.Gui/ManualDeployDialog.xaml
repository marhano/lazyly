<ui:FluentWindow x:Class="PublishTool.Gui.ManualDeployDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Manual Deploy" Height="640" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="DescriptionTextBlock" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Deploys a folder or zip file straight into an IIS site -- for a quick ad hoc deploy that doesn't need a registered project at all. Creates the site (and its own app pool) if it doesn't exist yet, same as any other auto-created site."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Site name" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SiteComboBox" Margin="0,6" IsEditable="True"
                          ToolTip="An existing site to deploy into, or a new name to create one."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Physical path" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" x:Name="PhysicalPathTextBox" Margin="0,0,6,0"
                                PlaceholderText="The site's physical path on disk"/>
                    <ui:Button Grid.Column="1" x:Name="BrowsePhysicalPathButton" Content="Browse..." Width="90" Click="BrowsePhysicalPathButton_Click"/>
                </Grid>

                <ui:ToggleSwitch Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoCreateSiteToggle"
                                 Content="Auto-create IIS site if it doesn't exist" Margin="0,10,0,6"
                                 Checked="AutoCreateSiteToggle_Toggled" Unchecked="AutoCreateSiteToggle_Toggled"
                                 ToolTip="Requires at least one binding below. Leave off to deploy into a site that already exists, unchanged."/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="NewSiteOptionsPanel">
                    <TextBlock Text="Site bindings" Margin="0,0,0,6"/>
                    <DataGrid x:Name="BindingsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="100" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="100"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                            <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Content="Add binding" Icon="{ui:SymbolIcon Add24}" Width="120" Click="AddBindingButton_Click"/>
                        <ui:Button Content="Remove binding" Icon="{ui:SymbolIcon Delete24}" Width="130" Margin="10,0,0,0" Click="RemoveBindingButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="App pool type" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PoolTemplateComboBox" SelectedIndex="0" HorizontalAlignment="Left" Width="220" Margin="0,0,0,10">
                        <ComboBoxItem Content=".NET CLR v4.0" Tag="DotNetFramework"/>
                        <ComboBoxItem Content="No Managed Code (static sites, Angular, etc.)" Tag="NoManagedCode"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Source" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                    <RadioButton x:Name="SourceFolderRadio" Content="Folder" IsChecked="True" GroupName="SourceType" VerticalAlignment="Center"/>
                    <RadioButton x:Name="SourceZipRadio" Content="Zip file" GroupName="SourceType" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Source path" VerticalAlignment="Center"/>
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" x:Name="SourcePathTextBox" Margin="0,0,6,0"
                                PlaceholderText="Folder or .zip file to deploy"/>
                    <ui:Button Grid.Column="1" Content="Browse..." Width="90" Click="BrowseSourcePathButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Label" VerticalAlignment="Center"/>
                <ui:TextBox Grid.Row="6" Grid.Column="1" x:Name="LabelTextBox" Margin="0,6"
                            PlaceholderText="Optional -- recorded as this deploy's &quot;version&quot; in history, e.g. hotfix-2026-01"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click"/>
            <ui:Button Content="Deploy" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="10,0,0,0" Click="DeployButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

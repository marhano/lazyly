<ui:FluentWindow x:Class="PublishTool.Gui.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Project" Height="820" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Local settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Facts about this machine -- where your clone of the repo lives, your own local IIS target. Never shared, always editable. Every field here is optional -- a project registered with none of them filled in can still be used to manage an existing build's IIS site, Event Log, or firewall rules."/>

                <Grid x:Name="ProjectRootFieldsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Project root folder&#10;(optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="ProjectRootTextBox" Margin="0,6,6,6" PlaceholderText="C:\src\MyProject"
                                ToolTip="Where the project's source lives -- for Angular, its package.json/angular.json; for Android, its Capacitor/Cordova config. Only needed to Publish; leave blank to just manage this project's IIS/Event Logs/firewall rules."
                                LostFocus="ProjectRootTextBox_LostFocus"/>
                    <ui:Button Grid.Row="0" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseProjectRoot_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AndroidDetectedCaptionText" Text="Detected" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AndroidDetectedLabel" Margin="0,6" VerticalAlignment="Center" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="(point at a project folder above)"/>
                </Grid>

                <StackPanel x:Name="AndroidSigningSectionPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="Release signing" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Optional, same fields as Android Studio's &quot;Generate Signed Bundle/APK&quot; dialog -- used to sign a release build. Leave unconfigured to fall back to the native project's own signingConfig, if it has one. Passwords are encrypted and never shared with your team."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keystore" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="AndroidSigningStatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button Grid.Column="2" Content="Configure signing..." Click="ConfigureAndroidSigningButton_Click"/>
                    </Grid>
                </StackPanel>

                <Grid x:Name="DotNetLocalFieldsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text=".csproj path (optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="CsprojTextBox" Margin="0,6,6,6" PlaceholderText="C:\src\MyProject\MyProject.csproj"
                                ToolTip="Only needed to Publish this project. Leave blank if you're only registering it to redeploy an existing build, or manage its Event Logs/IIS/firewall rules."/>
                    <ui:Button Grid.Row="0" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseCsproj_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="AssemblyInfo.cs&#10;(optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="AssemblyInfoTextBox" Margin="0,6,6,6" PlaceholderText="Properties\AssemblyInfo.cs"/>
                    <ui:Button Grid.Row="1" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseAssemblyInfo_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Publish profile&#10;(optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="PubxmlTextBox" Margin="0,6,6,6" PlaceholderText="FolderProfile"/>
                </Grid>

                <ui:ToggleSwitch x:Name="RemoteIisToggle" Content="Remote IIS" Margin="0,16,0,0"
                                 ToolTip="Per-user, a personal preference: only takes effect while &quot;Use dev server for projects&quot; is on in Settings. Controls only whether this project's dev-server environments (configured below, in Shared settings) are offered as a Publish tab deploy target -- the environments themselves are always visible/editable regardless of this toggle."/>
                <ui:ToggleSwitch x:Name="LocalIisToggle" Content="Local IIS" Margin="0,10,0,0"
                                 Checked="LocalIisToggle_Toggled" Unchecked="LocalIisToggle_Toggled"
                                 ToolTip="Per-user: when on, every publish you do of this project can deploy straight to your own local IIS. Teammates decide this independently for their own machines. Not available for Android projects -- there's no IIS equivalent for an installable APK/AAB. Note: whoever publishes with this on needs to run PublishTool as Administrator on their own machine, or the local deploy step will fail."/>
                <StackPanel x:Name="LocalEnvironmentsSectionPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Local environments" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Your own deploy targets for quick local testing (e.g. a personal Staging site). Per-user -- teammates configure their own independently. The folder used is always {root}\{project name}\{environment}."/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Host root path" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" x:Name="LocalHostRootPathTextBox" Margin="0,0,6,0" PlaceholderText="C:\PublishToolServerTest"/>
                        <ui:Button Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseLocalHostRootPath_Click"/>
                    </Grid>

                    <DataGrid x:Name="LocalEnvironmentsDataGrid" Height="160" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Environment" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Auto-create site" Binding="{Binding AutoCreateSite}" Width="110"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Edit" Width="65" Click="EditLocalEnvironmentButton_Click"/>
                                            <ui:Button Content="Remove" Width="75" Margin="6,0,0,0" Click="RemoveLocalEnvironmentButton_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:Button Content="Add environment" Icon="{ui:SymbolIcon Add24}" Width="150" Margin="0,8,0,0" Click="AddLocalEnvironmentButton_Click"/>
                </StackPanel>

                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,20,0,20"/>

                <DockPanel Margin="0,0,0,4">
                    <ui:Button x:Name="EditSharedSettingsButton" DockPanel.Dock="Right" Content="Edit shared settings"
                               Icon="{ui:SymbolIcon LockOpen24}" Width="180" Click="EditSharedSettingsButton_Click" Visibility="Collapsed"/>
                    <TextBlock Text="Shared settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Properties of the project itself. In remote mode, every PublishTool user sees the same values here."/>

                <TextBlock Text="Project type" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="ProjectTypeComboBox" HorizontalAlignment="Left" Width="240" Margin="0,0,0,10"
                          SelectionChanged="ProjectTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content=".NET" Tag="DotNet"/>
                    <ComboBoxItem Content="Angular" Tag="Angular"/>
                    <ComboBoxItem Content="Android (Capacitor/Cordova)" Tag="Android"/>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="1" x:Name="NameTextBox" Margin="0,6" PlaceholderText="MyProject"
                                ToolTip="Can't be changed after the project is first added -- it's the key everything else (the build folder, shared registrations) is filed under."/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project ID" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="1" x:Name="ProjectIdTextBox" Margin="0,6" PlaceholderText="e.g. BPS"
                                ToolTip="Short project code used as the release notes reference prefix, e.g. &quot;BPS&quot; produces references like BPS-2026-0007."/>
                </Grid>

                <StackPanel x:Name="DotNetSharedFieldsPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Extra publish&#10;targets (optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" x:Name="ExtraTargetsTextBox" Margin="0,6" PlaceholderText="e.g. CollectSQLiteInteropFiles"/>
                    </Grid>
                    <ui:ToggleSwitch x:Name="SdkStyleProjectToggle" Content="Modern SDK-style project (e.g. ASP.NET Core)" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel x:Name="AngularSharedFieldsPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Workspace project&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" x:Name="AngularWorkspaceProjectTextBox" Margin="0,6" PlaceholderText="e.g. my-app"
                                    ToolTip="For an Angular workspace with more than one buildable project -- which one to build. Leave blank for a single-app repo."/>
                    </Grid>
                </StackPanel>

                <ui:ToggleSwitch x:Name="UseAppConfigToggle" Content="Edit user-visible app config from the Publish tab" Margin="0,16,0,0"
                                  Checked="UseAppConfigToggle_Toggled" Unchecked="UseAppConfigToggle_Toggled"/>
                <StackPanel x:Name="AppConfigTypePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Config type" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="AppConfigTypeComboBox" HorizontalAlignment="Left" Width="280" DisplayMemberPath="DisplayName"/>

                    <TextBlock Text="Config file path (optional)" Margin="0,10,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="AppConfigPathTextBox" Margin="0,0,6,0" PlaceholderText="Leave blank to find it automatically at publish time"
                                    ToolTip="Optional. If left blank, PublishTool looks for a matching config file under the project's own source folder each time it's needed -- you'll be asked to pick if more than one is found."/>
                        <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseAppConfigPath_Click"/>
                    </Grid>
                </StackPanel>

                <ui:ToggleSwitch x:Name="UseEventLogToggle" Content="Enable Event Logs tab for this project" Margin="0,16,0,0"
                                  Checked="UseEventLogToggle_Toggled" Unchecked="UseEventLogToggle_Toggled"/>
                <StackPanel x:Name="EventLogPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Log name" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="EventLogNameTextBox" Margin="0,6" PlaceholderText="Application"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Identify entries by" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EventLogFilterTypeComboBox" Margin="0,6" HorizontalAlignment="Left" Width="240" SelectedIndex="0">
                            <ComboBoxItem Content="Event Source name" Tag="Source"/>
                            <ComboBoxItem Content="Message contains" Tag="MessageContains"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="EventLogMachineTextBox" Margin="0,6" PlaceholderText="(local machine)"
                                    ToolTip="Only used in local mode -- for a direct EventLogSession to a different machine. Ignored when reading via the dev server's own /api/eventlog."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Username&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="EventLogUsernameTextBox" Margin="0,6" PlaceholderText="(use current Windows identity)"/>
                    </Grid>

                    <TextBlock Text="Source name(s) or message text(s)" Margin="0,14,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="An entry matches if it matches ANY value below -- add more than one to catch multiple Source names (or message substrings) under the same project."/>
                    <ListBox x:Name="EventLogFilterValuesListBox" Height="90"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="NewEventLogFilterValueTextBox" PlaceholderText="e.g. MyApp, or a distinctive substring" Margin="0,0,6,0"/>
                        <ui:Button Grid.Column="1" Content="Add" Icon="{ui:SymbolIcon Add24}" Width="90" Click="AddEventLogFilterValueButton_Click"/>
                        <ui:Button Grid.Column="2" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Width="100" Margin="6,0,0,0" Click="RemoveEventLogFilterValueButton_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RemoteEnvironmentsSectionPanel" Margin="0,16,0,0">
                    <TextBlock Text="Dev-server environments" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Where this project's builds get deployed on the dev server -- e.g. Staging and Production. Shared: the same targets apply no matter who deploys. The folder used is always {root}\{project name}\{environment}."/>
                    <StackPanel x:Name="RemoteEnvironmentsPanel">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host root path" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1" x:Name="RemoteHostRootPathTextBox" PlaceholderText="C:\PublishToolServerTest (on the dev server)"/>
                        </Grid>

                        <DataGrid x:Name="RemoteEnvironmentsDataGrid" Height="160" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Environment" Binding="{Binding Name}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Auto-create site" Binding="{Binding AutoCreateSite}" Width="110"/>
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Edit" Width="65" Click="EditRemoteEnvironmentButton_Click"/>
                                                <ui:Button Content="Remove" Width="75" Margin="6,0,0,0" Click="RemoveRemoteEnvironmentButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ui:Button Content="Add environment" Icon="{ui:SymbolIcon Add24}" Width="150" Margin="0,8,0,0" Click="AddRemoteEnvironmentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Save project" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

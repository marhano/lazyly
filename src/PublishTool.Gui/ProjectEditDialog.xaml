<ui:FluentWindow x:Class="PublishTool.Gui.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Project" Height="820" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Local settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Facts about this machine -- where your clone of the repo lives, your own local IIS target. Never shared, always editable."/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameTextBox" Margin="0,6" PlaceholderText="MyProject"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text=".csproj path" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="CsprojTextBox" Margin="0,6,6,6" PlaceholderText="C:\src\MyProject\MyProject.csproj"/>
                    <ui:Button Grid.Row="1" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseCsproj_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="AssemblyInfo.cs&#10;(optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="AssemblyInfoTextBox" Margin="0,6,6,6" PlaceholderText="Properties\AssemblyInfo.cs"/>
                    <ui:Button Grid.Row="2" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseAssemblyInfo_Click"/>
                </Grid>

                <ui:ToggleSwitch x:Name="LocalIisToggle" Content="Local IIS" Margin="0,16,0,0"
                                 Checked="LocalIisToggle_Toggled" Unchecked="LocalIisToggle_Toggled"
                                 ToolTip="Per-user: when on, every publish you do of this project can deploy straight to your own local IIS. Teammates decide this independently for their own machines."/>
                <StackPanel x:Name="LocalEnvironmentsSectionPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Local environments" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Your own deploy targets for quick local testing (e.g. a personal Staging site). Per-user -- teammates configure their own independently. The folder used is always {root}\{project name}\{environment}."/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Host root path" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" x:Name="LocalHostRootPathTextBox" Margin="0,0,6,0" PlaceholderText="C:\PublishToolServerTest"/>
                        <ui:Button Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseLocalHostRootPath_Click"/>
                    </Grid>

                    <DataGrid x:Name="LocalEnvironmentsDataGrid" Height="120" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionChanged="LocalEnvironmentsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="LocalEnvironmentNameColumn" Header="Environment" SelectedItemBinding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Auto-create site" Binding="{Binding AutoCreateSite}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="Add environment" Icon="{ui:SymbolIcon Add24}" Width="150" Click="AddLocalEnvironmentButton_Click"/>
                        <ui:Button Content="Remove environment" Icon="{ui:SymbolIcon Delete24}" Width="160" Margin="10,0,0,0" Click="RemoveLocalEnvironmentButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="LocalEnvironmentBindingsLabel" Text="Site bindings for the selected environment" Margin="0,14,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <DataGrid x:Name="LocalEnvironmentBindingsDataGrid" Height="100" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                            <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="Add binding" Icon="{ui:SymbolIcon Add24}" Width="130" Click="AddLocalBindingButton_Click"/>
                        <ui:Button Content="Remove binding" Icon="{ui:SymbolIcon Delete24}" Width="140" Margin="10,0,0,0" Click="RemoveLocalBindingButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,20,0,20"/>

                <DockPanel Margin="0,0,0,4">
                    <ui:Button x:Name="EditSharedSettingsButton" DockPanel.Dock="Right" Content="Edit shared settings"
                               Icon="{ui:SymbolIcon LockOpen24}" Width="180" Click="EditSharedSettingsButton_Click" Visibility="Collapsed"/>
                    <TextBlock Text="Shared settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Properties of the project itself. In remote mode, every PublishTool user sees the same values here."/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Project ID" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="ProjectIdTextBox" Margin="0,6" PlaceholderText="e.g. BPS"
                                ToolTip="Short project code used as the release notes reference prefix, e.g. &quot;BPS&quot; produces references like BPS-2026-0007."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Publish profile" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="PubxmlTextBox" Margin="0,6" PlaceholderText="FolderProfile"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra publish&#10;targets (optional)" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="ExtraTargetsTextBox" Margin="0,6" PlaceholderText="e.g. CollectSQLiteInteropFiles"/>
                </Grid>

                <ui:ToggleSwitch x:Name="SdkStyleProjectToggle" Content="Modern SDK-style project (e.g. ASP.NET Core)" Margin="0,10,0,0"/>
                <ui:ToggleSwitch x:Name="ListInHostingToggle" Content="List builds in hosting site" IsChecked="True" Margin="0,10,0,0"/>

                <ui:ToggleSwitch x:Name="UseAppConfigToggle" Content="Edit user-visible app config from the Publish tab" Margin="0,16,0,0"
                                  Checked="UseAppConfigToggle_Toggled" Unchecked="UseAppConfigToggle_Toggled"/>
                <StackPanel x:Name="AppConfigTypePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Config type" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="AppConfigTypeComboBox" HorizontalAlignment="Left" Width="240" DisplayMemberPath="DisplayName"/>

                    <TextBlock Text="Config file path" Margin="0,10,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="AppConfigPathTextBox" Margin="0,0,6,0" PlaceholderText="C:\src\MyProject\Web.config"/>
                        <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Width="100" Click="BrowseAppConfigPath_Click"/>
                    </Grid>
                </StackPanel>

                <ui:ToggleSwitch x:Name="UseEventLogToggle" Content="Enable Event Logs tab for this project" Margin="0,16,0,0"
                                  Checked="UseEventLogToggle_Toggled" Unchecked="UseEventLogToggle_Toggled"/>
                <StackPanel x:Name="EventLogPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Log name" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="EventLogNameTextBox" Margin="0,6" PlaceholderText="Application"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Identify entries by" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EventLogFilterTypeComboBox" Margin="0,6" HorizontalAlignment="Left" Width="240" SelectedIndex="0">
                            <ComboBoxItem Content="Event Source name" Tag="Source"/>
                            <ComboBoxItem Content="Message contains" Tag="MessageContains"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Source name or&#10;message text" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="EventLogFilterValueTextBox" Margin="0,6" PlaceholderText="e.g. MyApp, or a distinctive substring"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Machine&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="EventLogMachineTextBox" Margin="0,6" PlaceholderText="(local machine)"
                                    ToolTip="Only used in local mode -- for a direct EventLogSession to a different machine. Ignored when reading via the dev server's own /api/eventlog."/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Username&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="EventLogUsernameTextBox" Margin="0,6" PlaceholderText="(use current Windows identity)"/>
                    </Grid>
                </StackPanel>

                <ui:ToggleSwitch x:Name="RemoteIisToggle" Content="Remote IIS" Margin="0,16,0,0"
                                 Checked="RemoteIisToggle_Toggled" Unchecked="RemoteIisToggle_Toggled"
                                 ToolTip="Per-user: only takes effect while &quot;Use dev server for projects&quot; is on in Settings. When on, shows this project's dev-server deploy target and offers it as a Publish tab option."/>
                <StackPanel x:Name="RemoteEnvironmentsSectionPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Dev-server environments" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Where this project's builds get deployed on the dev server -- e.g. Staging and Production. Shared: the same targets apply no matter who deploys. The folder used is always {root}\{project name}\{environment}."/>
                    <StackPanel x:Name="RemoteEnvironmentsPanel">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host root path" VerticalAlignment="Center"/>
                            <ui:TextBox Grid.Column="1" x:Name="RemoteHostRootPathTextBox" PlaceholderText="C:\PublishToolServerTest (on the dev server)"/>
                        </Grid>

                        <DataGrid x:Name="RemoteEnvironmentsDataGrid" Height="120" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionChanged="RemoteEnvironmentsDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="RemoteEnvironmentNameColumn" Header="Environment" SelectedItemBinding="{Binding Name}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Auto-create site" Binding="{Binding AutoCreateSite}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add environment" Icon="{ui:SymbolIcon Add24}" Width="150" Click="AddRemoteEnvironmentButton_Click"/>
                            <ui:Button Content="Remove environment" Icon="{ui:SymbolIcon Delete24}" Width="160" Margin="10,0,0,0" Click="RemoveRemoteEnvironmentButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="Site bindings for the selected environment" Margin="0,14,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <DataGrid x:Name="RemoteEnvironmentBindingsDataGrid" Height="100" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Protocol}" Width="80"/>
                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                                <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add binding" Icon="{ui:SymbolIcon Add24}" Width="130" Click="AddRemoteBindingButton_Click"/>
                            <ui:Button Content="Remove binding" Icon="{ui:SymbolIcon Delete24}" Width="140" Margin="10,0,0,0" Click="RemoveRemoteBindingButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Save project" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow x:Class="PublishTool.Gui.IisAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="IIS Audit Trail" Height="480" Width="740"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Every site/application pool started, stopped, removed, or recycled here -- who did it and when" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ui:TextBox Grid.Row="1" x:Name="SearchTextBox" Margin="0,0,0,10"
                    PlaceholderText="Search name, action, details, by..."
                    TextChanged="SearchTextBox_TextChanged"/>

        <DataGrid Grid.Row="2" x:Name="AuditDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding PerformedAtUtc}" Width="160"/>
                <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding EntityName}" Width="*"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="1.5*"/>
                <DataGridTextColumn Header="By" Binding="{Binding PerformedBy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Close" Appearance="Primary" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

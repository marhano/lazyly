<ui:FluentWindow x:Class="PublishTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PublishTool.Gui"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="PublishTool" Height="800" Width="1200" MinHeight="560" MinWidth="820"
        Icon="pack://application:,,,/Assets/app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PublishTool" Icon="pack://application:,,,/Assets/app.ico"/>

        <ui:InfoBar Grid.Row="1" x:Name="ElevationInfoBar" Margin="16,8,16,0"
                    Severity="Informational" IsOpen="False"
                    Title="Not running as Administrator"
                    Message="Auto-creating IIS sites and starting/stopping sites or application pools require running PublishTool elevated. Right-click the app and choose &quot;Run as administrator&quot; to enable those features."/>

        <Grid Grid.Row="2" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="OutputColumnDefinition" Width="380" MinWidth="260" MaxWidth="900"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Publish">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectComboBox" Margin="0,6"
                                  SelectionChanged="ProjectComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Git branch" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:AutoSuggestBox Grid.Column="0" x:Name="GitBranchAutoSuggestBox" Margin="0,0,6,0"
                                               PlaceholderText="Search branches..."
                                               ToolTip="Checked out automatically before building. Use Checkout to switch the working tree now, e.g. to preview that branch's App Config."/>
                            <ui:Button Grid.Column="1" x:Name="CheckoutBranchButton" Content="Checkout"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="CheckoutBranchButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                            <ComboBox x:Name="VersionComboBox" IsEditable="True" Text=""
                                      SelectionChanged="VersionComboBox_SelectionChanged"
                                      TextBoxBase.TextChanged="VersionComboBox_TextChanged"/>
                            <TextBlock x:Name="VersionOverwriteHintTextBlock" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="This version already exists -- publishing will overwrite its build and release notes."
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="PublishButton" Content="Publish"
                                       Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}"
                                       Width="140" Click="PublishButton_Click"/>
                            <ui:Button x:Name="RefreshProjectsButton" Content="Refresh projects"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Width="140" Margin="10,0,0,0" Click="RefreshProjectsButton_Click"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                            <StackPanel>
                                <ui:CardExpander x:Name="AppConfigExpander" Header="App Config" IsExpanded="False"
                                                  Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel Margin="2">
                                        <TextBlock x:Name="AppConfigDescriptionTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <DataGrid x:Name="AppConfigDataGrid" MinHeight="280" AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:Button Content="Add setting" Icon="{ui:SymbolIcon Add24}" Width="130"
                                                       Click="AddAppConfigSettingButton_Click"/>
                                            <ui:Button Content="Remove setting" Icon="{ui:SymbolIcon Delete24}" Width="150"
                                                       Margin="10,0,0,0" Click="RemoveAppConfigSettingButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:CardExpander Header="Release notes for this build" IsExpanded="False">
                                    <UniformGrid Columns="2" Margin="2">
                                        <local:ReleaseNoteItemsControl x:Name="FeaturesEditor" Header="Features and Enhancements" Margin="0,0,10,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="FixesEditor" Header="Fixes" Margin="0,0,0,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="OtherUpdatesEditor" Header="Other Updates" Margin="0,0,10,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="BacklogItemsEditor" Header="Backlog Items" Margin="0,0,0,10"/>
                                    </UniformGrid>
                                </ui:CardExpander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Add Project">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NewProjectNameTextBox"
                                    Margin="0,6" PlaceholderText="MyProject"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project ID" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NewProjectIdTextBox"
                                    Margin="0,6" PlaceholderText="e.g. BPS"
                                    ToolTip="Short project code used as the release notes reference prefix, e.g. &quot;BPS&quot; produces references like BPS-2026-0007. Optional -- release notes are only generated at publish time when this is set."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text=".csproj path" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="NewProjectCsprojTextBox" Margin="0,6,6,6"
                                    PlaceholderText="C:\src\MyProject\MyProject.csproj"/>
                        <ui:Button Grid.Row="2" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                   Width="100" Click="BrowseCsproj_Click"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Publish profile" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="NewProjectPubxmlTextBox" Margin="0,6,6,6"
                                    PlaceholderText="FolderProfile"/>
                        <ui:Button Grid.Row="3" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                   Width="100" Click="BrowsePubxml_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="AssemblyInfo.cs&#10;(optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="NewProjectAssemblyInfoTextBox" Margin="0,6,6,6"
                                    PlaceholderText="Properties\AssemblyInfo.cs"/>
                        <ui:Button Grid.Row="4" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                   Width="100" Click="BrowseAssemblyInfo_Click"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="IIS host folder" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="5" Grid.Column="1" x:Name="NewProjectIisHostTextBox" Margin="0,6,6,6"
                                    PlaceholderText="C:\inetpub\wwwroot\MyProject"/>
                        <ui:Button Grid.Row="5" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                   Width="100" Click="BrowseIisHost_Click"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Extra publish&#10;targets (optional)" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NewProjectExtraTargetsTextBox" Margin="0,6"
                                    PlaceholderText="e.g. CollectSQLiteInteropFiles"
                                    ToolTip="Semicolon-separated MSBuild targets to force during publish, for packages whose own .targets don't hook into this toolset -- e.g. CollectSQLiteInteropFiles"/>

                        <ui:ToggleSwitch Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" x:Name="SdkStyleProjectToggle"
                                         Content="Modern SDK-style project (e.g. ASP.NET Core)" Margin="0,10,0,0"
                                         ToolTip="Leave off for classic .NET Framework Web Deploy projects -- the two publish very differently."/>

                        <ui:ToggleSwitch Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ListInHostingToggle"
                                         Content="List builds in hosting site" IsChecked="True" Margin="0,10,0,0"
                                         ToolTip="Builds are always archived to the build repository either way; this only controls whether they show up in the build-hosting site's listing."/>

                        <ui:ToggleSwitch Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AutoCreateIisSiteToggle"
                                         Content="Auto-create IIS site if missing" Margin="0,10,0,0"
                                         Checked="AutoCreateIisSiteToggle_Toggled" Unchecked="AutoCreateIisSiteToggle_Toggled"/>

                        <ui:ToggleSwitch Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" x:Name="UseAppConfigToggle"
                                         Content="Edit user-visible app config from the Publish tab" Margin="0,10,0,0"
                                         ToolTip="For a version number or other appSettings shown to end users -- separate from AssemblyInfo.cs, which only affects the .NET assembly's own version."
                                         Checked="UseAppConfigToggle_Toggled" Unchecked="UseAppConfigToggle_Toggled"/>

                        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" x:Name="AppConfigPanel"
                                    Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Config type" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AppConfigTypeComboBox" HorizontalAlignment="Left" Width="240"
                                      DisplayMemberPath="DisplayName"/>

                            <TextBlock Text="Config file path" Margin="0,10,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="AppConfigPathTextBox" Margin="0,0,6,0"
                                            PlaceholderText="C:\src\MyProject\Web.config"/>
                                <ui:Button Grid.Column="1" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                           Width="100" Click="BrowseAppConfigPath_Click"/>
                            </Grid>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" x:Name="UseEventLogToggle"
                                         Content="Enable Event Logs tab for this project" Margin="0,10,0,0"
                                         ToolTip="Reads Windows Event Log entries for this project into the Event Logs tab."
                                         Checked="UseEventLogToggle_Toggled" Unchecked="UseEventLogToggle_Toggled"/>

                        <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" x:Name="EventLogPanel"
                                    Visibility="Collapsed" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Log name" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="EventLogNameTextBox" Margin="0,6"
                                            PlaceholderText="Application"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Identify entries by" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EventLogFilterTypeComboBox" Margin="0,6"
                                          HorizontalAlignment="Left" Width="240" SelectedIndex="0">
                                    <ComboBoxItem Content="Event Source name" Tag="Source"/>
                                    <ComboBoxItem Content="Message contains" Tag="MessageContains"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source name or&#10;message text" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="EventLogFilterValueTextBox" Margin="0,6"
                                            PlaceholderText="e.g. MyApp, or a distinctive substring"
                                            ToolTip="An Event Log Source name if 'Identify entries by' is Source, or a substring to match against each entry's message if it's Message Contains."/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Machine&#10;(optional)" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="EventLogMachineTextBox" Margin="0,6"
                                            PlaceholderText="(local machine)"
                                            ToolTip="Read the event log from a different computer instead of this one. Requires Remote Event Log Management to be allowed through that machine's firewall."/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Username&#10;(optional)" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="EventLogUsernameTextBox" Margin="0,6"
                                            PlaceholderText="(use current Windows identity)"
                                            ToolTip="Only needed for a remote machine that doesn't trust your current Windows identity. You'll be prompted for the password (with an option to save it) from the Event Logs tab."/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" x:Name="IisBindingsPanel"
                                    Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Site bindings" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <DataGrid x:Name="IisBindingsDataGrid" Height="140" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Protocol}" Width="80"/>
                                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                                    <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="Add binding" Icon="{ui:SymbolIcon Add24}" Width="130" Click="AddBindingButton_Click"/>
                                <ui:Button Content="Remove binding" Icon="{ui:SymbolIcon Delete24}" Width="140" Margin="10,0,0,0" Click="RemoveBindingButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="SaveProjectButton" Content="Save project" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Save24}" Width="140" Click="SaveProjectButton_Click"/>
                            <ui:Button x:Name="NewProjectButton" Content="Clear form" Icon="{ui:SymbolIcon Eraser24}"
                                       Width="110" Margin="10,0,0,0" Click="NewProjectButton_Click"/>
                            <ui:Button x:Name="RemoveProjectButton" Content="Remove selected" Icon="{ui:SymbolIcon Delete24}"
                                       Width="150" Margin="10,0,0,0" Click="RemoveProjectButton_Click"/>
                        </StackPanel>
                        </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Registered projects (click to edit)"
                                       Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ListBox Grid.Row="1" x:Name="RegisteredProjectsListBox"
                                     DisplayMemberPath="Name" SelectionChanged="RegisteredProjectsListBox_SelectionChanged"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="IIS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RefreshIisButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RefreshIisButton_Click"/>
                        </DockPanel>

                        <TabControl Grid.Row="1">
                            <TabItem Header="Sites">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0" x:Name="IisSitesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                                            <DataGridTextColumn Header="Bindings" Binding="{Binding Bindings}" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <ui:Button Content="Start site" Icon="{ui:SymbolIcon Play24}" Width="120" Click="StartSiteButton_Click"/>
                                        <ui:Button Content="Stop site" Icon="{ui:SymbolIcon Stop24}" Width="120" Margin="10,0,0,0" Click="StopSiteButton_Click"/>
                                        <ui:Button Content="Browse site" Icon="{ui:SymbolIcon Globe24}" Width="130" Margin="10,0,0,0" Click="BrowseSiteButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Application Pools">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0" x:Name="IisAppPoolsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                                            <DataGridTextColumn Header=".NET Version" Binding="{Binding ManagedRuntimeVersion}" Width="120"/>
                                            <DataGridTextColumn Header="Pipeline" Binding="{Binding PipelineMode}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <ui:Button Content="Start pool" Icon="{ui:SymbolIcon Play24}" Width="120" Click="StartAppPoolButton_Click"/>
                                        <ui:Button Content="Stop pool" Icon="{ui:SymbolIcon Stop24}" Width="120" Margin="10,0,0,0" Click="StopAppPoolButton_Click"/>
                                        <ui:Button Content="Recycle pool" Icon="{ui:SymbolIcon ArrowClockwise24}" Width="130" Margin="10,0,0,0" Click="RecycleAppPoolButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Event Logs">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Project" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="EventLogProjectComboBox" Margin="0,0,10,0"
                                      SelectionChanged="EventLogProjectComboBox_SelectionChanged"/>

                            <ui:TextBox Grid.Column="2" x:Name="EventLogSearchTextBox" Margin="0,0,10,0"
                                        PlaceholderText="Search message, source..."
                                        TextChanged="EventLogSearchTextBox_TextChanged"/>

                            <ui:Button Grid.Column="3" x:Name="RefreshEventLogButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Margin="0,0,10,0"
                                       Click="RefreshEventLogButton_Click"/>

                            <ui:Button Grid.Column="4" x:Name="ExportEventLogButton" Content="Export CSV"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Width="120" Click="ExportEventLogButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="EventLogLevelFilterComboBox" Margin="0,0,20,0"
                                      SelectedIndex="0" SelectionChanged="EventLogLevelFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All levels"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="Error"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Information"/>
                                <ComboBoxItem Content="Verbose"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Method" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" x:Name="EventLogMethodFilterComboBox"
                                      SelectedIndex="0" SelectionChanged="EventLogMethodFilterComboBox_SelectionChanged"/>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="EventLogStatusTextBlock" Margin="0,10,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <DataGrid Grid.Row="3" x:Name="EventLogDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  PreviewMouseLeftButtonUp="EventLogDataGrid_PreviewMouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="160"/>
                                <DataGridTemplateColumn Header="Level" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding LevelBackground}" CornerRadius="4"
                                                    Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Level}" Foreground="{Binding LevelForeground}"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70"/>
                                <DataGridTextColumn Header="Method" Binding="{Binding MethodName}" Width="160"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding MessageSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Command">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <ui:Button DockPanel.Dock="Right" x:Name="RunCommandButton" Content="Run" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Play24}" Width="100" Click="RunCommandButton_Click"/>
                            <ui:TextBox x:Name="CommandInputBox" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                        PlaceholderText="publish --project MyApp --version 1.0.0.R0001B"
                                        KeyDown="CommandInputBox_KeyDown"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Type any PublishTool command, e.g. publish --project MyApp --version 1.0.0.R0001B, or add-project --name MyApp --csproj C:\src\MyApp\MyApp.csproj --pubxml FolderProfile --iis-host C:\inetpub\wwwroot\MyApp"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Builds root" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="BuildsRootTextBox" Margin="0,6,6,6"/>
                        <ui:Button Grid.Row="0" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                   Width="100" Click="BrowseBuildsRootButton_Click"/>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="SaveSettingsButton" Content="Save" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Save24}" Width="110" Click="SaveSettingsButton_Click"/>
                            <ui:Button x:Name="OpenBuildsRootButton" Content="Open in Explorer" Icon="{ui:SymbolIcon Open24}"
                                       Width="150" Margin="10,0,0,0" Click="OpenBuildsRootButton_Click"/>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DarkModeToggle"
                                         Content="Dark mode" Margin="0,20,0,0" Checked="DarkModeToggle_Toggled" Unchecked="DarkModeToggle_Toggled"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0">
                            <TextBlock Text="Accent color" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#0078D4" Cursor="Hand"
                                    Tag="Blue" ToolTip="Blue" MouseLeftButtonUp="AccentSwatch_Click"/>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#8764B8" Cursor="Hand"
                                    Tag="Purple" ToolTip="Purple" Margin="10,0,0,0" MouseLeftButtonUp="AccentSwatch_Click"/>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#107C10" Cursor="Hand"
                                    Tag="Green" ToolTip="Green" Margin="10,0,0,0" MouseLeftButtonUp="AccentSwatch_Click"/>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="StartOnStartupToggle"
                                         Content="Start on Windows startup" Margin="0,20,0,0"
                                         Checked="StartOnStartupToggle_Toggled" Unchecked="StartOnStartupToggle_Toggled"
                                         ToolTip="Closing the window minimizes PublishTool to the system tray instead of exiting -- right-click the tray icon to exit fully."/>
                    </Grid>
                </TabItem>

                <TabItem Header="Help">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="AppVersionTextBlock" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <DockPanel Grid.Row="1" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RecheckDependenciesButton" Content="Recheck"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RecheckDependenciesButton_Click"/>
                            <TextBlock Text="Dependencies" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="External tools PublishTool relies on. MSBuild is required for Publish; IIS (appcmd.exe) is required for auto-creating sites and the IIS tab."/>

                        <DataGrid Grid.Row="3" x:Name="DependenciesDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dependency" Binding="{Binding Name}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusTextBlock" Text="Idle"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Width="160" Margin="0,0,10,0"/>
                <ui:Button DockPanel.Dock="Right" x:Name="ToggleOutputButton" Content="Hide output"
                           Icon="{ui:SymbolIcon PanelRight24}" Width="130" Click="ToggleOutputButton_Click"/>
                <ProgressBar x:Name="PublishProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0"/>
            </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" x:Name="OutputSplitter" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"/>

            <Border Grid.Column="2" x:Name="OutputPanel" Margin="6,0,0,0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Output" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" x:Name="OutputLogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

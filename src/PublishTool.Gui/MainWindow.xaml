<ui:FluentWindow x:Class="PublishTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PublishTool.Gui"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="PublishTool" Height="800" Width="1200" MinHeight="560" MinWidth="820"
        Icon="pack://application:,,,/Assets/app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PublishTool" Icon="pack://application:,,,/Assets/app.ico"/>

        <ui:InfoBar Grid.Row="1" x:Name="ElevationInfoBar" Margin="16,8,16,0"
                    Severity="Informational" IsOpen="False"
                    Title="Not running as Administrator"
                    Message="Managing this machine's own IIS sites/app pools and firewall rules (the IIS and Firewall tabs) requires running PublishTool elevated. Right-click the app and choose &quot;Run as administrator&quot; if you need those -- publishing itself, and any dev-server (remote) IIS actions, work fine without it."/>

        <Grid Grid.Row="2" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="OutputColumnDefinition" Width="380" MinWidth="260" MaxWidth="900"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Publish">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectComboBox" Margin="0,6"
                                  SelectionChanged="ProjectComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Git branch" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:AutoSuggestBox Grid.Column="0" x:Name="GitBranchAutoSuggestBox" Margin="0,0,6,0"
                                               PlaceholderText="Search branches..."
                                               ToolTip="Checked out automatically before building. Use Checkout to switch the working tree now, e.g. to preview that branch's App Config."/>
                            <ui:Button Grid.Column="1" x:Name="CheckoutBranchButton" Content="Checkout"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="CheckoutBranchButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                            <ComboBox x:Name="VersionComboBox" IsEditable="True" Text=""
                                      SelectionChanged="VersionComboBox_SelectionChanged"
                                      TextBoxBase.TextChanged="VersionComboBox_TextChanged"/>
                            <TextBlock x:Name="VersionOverwriteHintTextBlock" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="This version already exists -- publishing will overwrite its build and release notes."
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DeploySelectionPanel" Margin="0,6,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Deploy target" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DeployTargetComboBox" Margin="0,6"
                                          SelectionChanged="DeployTargetComboBox_SelectionChanged"
                                          ToolTip="Which side to deploy this publish to -- your own local IIS, or the dev server's. Only shows sides this project has IIS deployment enabled for."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DeployEnvironmentLabel" Text="Deploy to" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DeployEnvironmentComboBox" Margin="0,6"
                                          ToolTip="Which named environment (e.g. Staging, Production) within the selected deploy target to deploy to."/>
                            </Grid>
                            <ui:InfoBar x:Name="LocalDeployElevationInfoBar" Margin="0,6,0,0"
                                        Severity="Warning" IsOpen="False" IsClosable="False"
                                        Title="Administrator required"
                                        Message="Deploying to your own machine's IIS needs PublishTool running as Administrator, or this publish's local deploy step will fail. Close the app and relaunch it with &quot;Run as administrator&quot;, or switch Deploy target to a dev-server environment instead."/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AndroidBuildOptionsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Artifact type" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AndroidArtifactTypeComboBox" Margin="0,6" HorizontalAlignment="Left" Width="180" SelectedIndex="0"
                                          SelectionChanged="AndroidArtifactTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="APK" Tag="Apk"/>
                                    <ComboBoxItem Content="AAB" Tag="Aab"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Build variant" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AndroidBuildVariantComboBox" Margin="0,6" HorizontalAlignment="Left" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="release"/>
                                    <ComboBoxItem Content="debug"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AppConfigCandidatePanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Config file to edit" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="AppConfigCandidatePathComboBox" HorizontalAlignment="Left"
                                      SelectionChanged="AppConfigCandidatePathComboBox_SelectionChanged"
                                      ToolTip="No fixed config path is set on this project -- pick which of the automatically found files to edit for this publish."/>
                        </Grid>

                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:ToggleSwitch x:Name="MarkAsLatestToggle" Content="Mark as latest release"
                                             ToolTip="Shown as &quot;(latest)&quot; next to this build on the hosting site. Only one build per project can be latest -- marking this one un-flags whichever build had it before."/>
                            <ui:ToggleSwitch x:Name="ListInHostingToggle" Content="List in hosting site" IsChecked="True" Margin="24,0,0,0"
                                             ToolTip="Whether this build appears in the build-hosting site's listing. Turn off for a throwaway test build you don't want showing up there -- it's still archived either way."/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="PublishButton" Content="Publish"
                                       Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}"
                                       Width="140" Click="PublishButton_Click"/>
                            <ui:Button x:Name="RefreshProjectsButton" Content="Refresh projects"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Width="140" Margin="10,0,0,0" Click="RefreshProjectsButton_Click"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                            <StackPanel>
                                <ui:CardExpander x:Name="AppConfigExpander" Header="App Config" IsExpanded="False"
                                                  Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel Margin="2">
                                        <TextBlock x:Name="AppConfigDescriptionTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <DataGrid x:Name="AppConfigDataGrid" MinHeight="280" AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:Button Content="Add setting" Icon="{ui:SymbolIcon Add24}" Width="130"
                                                       Click="AddAppConfigSettingButton_Click"/>
                                            <ui:Button Content="Remove setting" Icon="{ui:SymbolIcon Delete24}" Width="150"
                                                       Margin="10,0,0,0" Click="RemoveAppConfigSettingButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:CardExpander x:Name="AndroidConfigExpander" Header="Android Config" IsExpanded="False"
                                                  Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid Margin="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bundle Id" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="AndroidBundleIdTextBox" Margin="0,6"
                                                    PlaceholderText="Not found -- leave blank to keep unchanged"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="AndroidDisplayNameTextBox" Margin="0,6"
                                                    PlaceholderText="Not found -- leave blank to keep unchanged"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version Number" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="AndroidVersionNumberTextBox" Margin="0,6"
                                                    PlaceholderText="Not found -- leave blank to keep unchanged"
                                                    ToolTip="Android's versionName, e.g. 1.0.1"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Build Number" VerticalAlignment="Center"/>
                                        <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="AndroidBuildNumberTextBox" Margin="0,6"
                                                    PlaceholderText="Not found -- leave blank to keep unchanged"
                                                    ToolTip="Android's versionCode -- must strictly increase release over release for Play Store uploads."/>
                                    </Grid>
                                </ui:CardExpander>

                                <ui:CardExpander Header="Release notes for this build" IsExpanded="False">
                                    <UniformGrid Columns="2" Margin="2">
                                        <local:ReleaseNoteItemsControl x:Name="FeaturesEditor" Header="Features and Enhancements" Margin="0,0,10,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="FixesEditor" Header="Fixes" Margin="0,0,0,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="OtherUpdatesEditor" Header="Other Updates" Margin="0,0,10,10"/>
                                        <local:ReleaseNoteItemsControl x:Name="BacklogItemsEditor" Header="Backlog Items" Margin="0,0,0,10"/>
                                    </UniformGrid>
                                </ui:CardExpander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Projects">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Right" x:Name="AllProjectsHistoryButton" Content="All history"
                                           Icon="{ui:SymbolIcon History24}" Padding="10,4" Margin="6,0,0,0"
                                           ToolTip="View every action recorded across every project -- add/remove, settings changes, publishes, deploys, build changes."
                                           Click="AllProjectsHistoryButton_Click"/>
                                <ui:Button DockPanel.Dock="Right" x:Name="RefreshRegisteredProjectsButton" Content="Refresh"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Padding="10,4"
                                           ToolTip="Reload the project list -- picks up projects another teammate added, or config they changed on an existing one."
                                           Click="RefreshRegisteredProjectsButton_Click"/>
                                <TextBlock Text="Registered projects" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" x:Name="RegisteredProjectsListBox"
                                     DisplayMemberPath="Name" SelectionChanged="RegisteredProjectsListBox_SelectionChanged"/>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <ui:Button x:Name="AddProjectButton" Content="Add project" Appearance="Primary"
                                           Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch" Click="AddProjectButton_Click"/>
                                <ui:Button x:Name="EditProjectButton" Content="Edit" Icon="{ui:SymbolIcon Edit24}"
                                           Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="EditProjectButton_Click"/>
                                <ui:Button x:Name="RemoveProjectButton" Content="Remove" Icon="{ui:SymbolIcon Delete24}"
                                           Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="RemoveProjectButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Width="1" Margin="12,0" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right" x:Name="ProjectHistoryButton" Content="History"
                                           Icon="{ui:SymbolIcon History24}" Width="110" Margin="6,0,0,0" Click="ProjectHistoryButton_Click"
                                           ToolTip="View this project's own audit trail -- add/remove, settings changes, publishes, deploys, build changes."/>
                                <ui:Button DockPanel.Dock="Right" x:Name="RefreshBuildsButton" Content="Refresh"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RefreshBuildsButton_Click"/>
                                <TextBlock x:Name="BuildHistoryTitleTextBlock" Text="Select a project to see its build history"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="BuildHistoryDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120"/>
                                    <DataGridTextColumn Header="Published" Binding="{Binding PublishedAtUtc, Converter={StaticResource UtcToPhTimeConverter}}" Width="160"/>
                                    <DataGridTextColumn Header="Published by" Binding="{Binding PublishedBy}" Width="140"/>
                                    <DataGridTextColumn Header="Latest" Binding="{Binding IsLatest}" Width="60"/>
                                    <DataGridTextColumn Header="Listed" Binding="{Binding ListInHosting}" Width="60"/>
                                    <DataGridTemplateColumn Header="Actions" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Content="Deploy this version" Icon="{ui:SymbolIcon Rocket24}"
                                                               Width="150" Margin="0,2,6,2" Click="DeployBuildButton_Click">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanDeploy}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                    <ui:Button Content="Mark latest" Icon="{ui:SymbolIcon Star24}"
                                                               Width="110" Margin="0,2,6,2" Click="MarkBuildLatestButton_Click"/>
                                                    <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}"
                                                               Width="90" Margin="0,2" Click="DeleteBuildButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="IIS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RefreshIisButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RefreshIisButton_Click"/>
                            <ui:Button DockPanel.Dock="Right" x:Name="IisHistoryButton" Content="All history"
                                       Icon="{ui:SymbolIcon History24}" Width="110" Margin="0,0,10,0" Click="IisHistoryButton_Click"
                                       ToolTip="View every site/application pool action recorded here -- start/stop/remove/recycle, who did it and when."/>
                            <ui:Button DockPanel.Dock="Right" x:Name="ManualDeployButton" Content="Manual deploy"
                                       Icon="{ui:SymbolIcon ArrowUpload24}" Width="130" Margin="0,0,10,0" Click="ManualDeployButton_Click"
                                       ToolTip="Deploy a folder or zip file into a new or existing IIS site, without going through a registered project's build history. Works in both local and remote mode."/>
                        </DockPanel>

                        <TabControl Grid.Row="1">
                            <TabItem Header="Sites">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="IisSiteStateFilterComboBox" Width="150" SelectedIndex="0"
                                                  SelectionChanged="IisSiteStateFilterComboBox_SelectionChanged">
                                            <ComboBoxItem Content="All sites"/>
                                            <ComboBoxItem Content="Started"/>
                                            <ComboBoxItem Content="Stopped"/>
                                        </ComboBox>
                                        <ui:ToggleSwitch x:Name="ShowAllIisSitesToggle" Content="Show all IIS sites" Margin="16,0,0,0"
                                                         Checked="ShowAllIisSitesToggle_Toggled" Unchecked="ShowAllIisSitesToggle_Toggled"
                                                         ToolTip="Off: only sites PublishTool has deployed to (marked [PT]). On: every IIS site on this server, including ones PublishTool never touched."/>
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" x:Name="IisSitesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                                            <DataGridTextColumn Header="Bindings" Binding="{Binding Bindings}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Deployed Version" Binding="{Binding DeployedVersion}" Width="120"/>
                                            <DataGridTextColumn Header="Deployed At" Binding="{Binding DeployedAtUtc, Converter={StaticResource UtcToPhTimeConverter}}" Width="160"/>
                                            <DataGridTextColumn Header="Deployed By" Binding="{Binding DeployedBy}" Width="120"/>
                                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start site"
                                                                       Width="36" Margin="0,2,4,2" Click="StartSiteButton_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Started">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                            <ui:Button Icon="{ui:SymbolIcon Stop24}" ToolTip="Stop site"
                                                                       Width="36" Margin="0,2,4,2" Click="StopSiteButton_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Started">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                            <ui:Button Icon="{ui:SymbolIcon Globe24}" ToolTip="Browse site"
                                                                       Width="36" Margin="0,2,4,2" Click="BrowseSiteButton_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Started">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                            <ui:Button Icon="{ui:SymbolIcon History24}" ToolTip="Deployment history"
                                                                       Width="36" Margin="0,2,4,2" Click="SiteHistoryButton_Click"/>
                                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove site"
                                                                       Width="36" Margin="0,2" Click="RemoveSiteButton_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Application Pools">
                                <Grid Margin="12">
                                    <DataGrid x:Name="IisAppPoolsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                                            <DataGridTextColumn Header=".NET Version" Binding="{Binding ManagedRuntimeVersion}" Width="120"/>
                                            <DataGridTextColumn Header="Pipeline" Binding="{Binding PipelineMode}" Width="100"/>
                                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start pool"
                                                                       Width="36" Margin="0,2,4,2" Click="StartAppPoolButton_Click"/>
                                                            <ui:Button Icon="{ui:SymbolIcon Stop24}" ToolTip="Stop pool"
                                                                       Width="36" Margin="0,2,4,2" Click="StopAppPoolButton_Click"/>
                                                            <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Recycle pool"
                                                                       Width="36" Margin="0,2,4,2" Click="RecycleAppPoolButton_Click"/>
                                                            <ui:Button Icon="{ui:SymbolIcon Key24}" ToolTip="Set identity"
                                                                       Width="36" Margin="0,2" Click="SetAppPoolIdentityButton_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Firewall">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RefreshFirewallButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RefreshFirewallButton_Click"/>
                            <ui:Button DockPanel.Dock="Right" x:Name="FirewallHistoryButton" Content="History"
                                       Icon="{ui:SymbolIcon History24}" Width="110" Margin="0,0,10,0" Click="FirewallHistoryButton_Click"/>
                            <ui:ToggleSwitch DockPanel.Dock="Right" x:Name="ShowAllFirewallRulesToggle" Content="Show all rules"
                                             Margin="0,0,16,0" Checked="ShowAllFirewallRulesToggle_Toggled" Unchecked="ShowAllFirewallRulesToggle_Toggled"
                                             ToolTip="Shows every rule on the system, not just PublishTool's own -- useful for checking if a port's already taken. Edit/Remove still only work on PublishTool's own [IIS] rules."/>
                            <TextBlock Text="Inbound rules PublishTool has created (not a general firewall console)"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" x:Name="FirewallRulesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="140"/>
                                <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Edit selected rule" Icon="{ui:SymbolIcon Edit24}" Width="150"
                                           Click="EditFirewallRuleButton_Click"/>
                                <ui:Button Content="Remove selected rule" Icon="{ui:SymbolIcon Delete24}" Width="160" Margin="10,0,0,0"
                                           Click="RemoveFirewallRuleButton_Click"/>
                            </StackPanel>

                            <TextBlock Text="Add inbound rule" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBox x:Name="FirewallRuleLabelTextBox" Width="180" Margin="0,0,16,0"
                                            PlaceholderText="e.g. Staging site"/>
                                <TextBlock Text="Ports" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBox x:Name="FirewallRulePortTextBox" Width="150" Margin="0,0,16,0"
                                            PlaceholderText="8080 or 9001,9005-9008"/>
                                <TextBlock Text="Protocol" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FirewallRuleProtocolComboBox" Width="90" SelectedIndex="0" Margin="0,0,16,0">
                                    <ComboBoxItem Content="TCP"/>
                                    <ComboBoxItem Content="UDP"/>
                                </ComboBox>
                                <ui:Button Content="Add rule" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Width="120"
                                           Click="AddFirewallRuleButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Event Logs">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Project" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="EventLogProjectComboBox" Margin="0,0,10,0"
                                      SelectionChanged="EventLogProjectComboBox_SelectionChanged"/>

                            <ui:TextBox Grid.Column="2" x:Name="EventLogSearchTextBox" Margin="0,0,10,0"
                                        PlaceholderText="Search message, source..."
                                        TextChanged="EventLogSearchTextBox_TextChanged"/>

                            <ui:Button Grid.Column="3" x:Name="RefreshEventLogButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Margin="0,0,10,0"
                                       Click="RefreshEventLogButton_Click"/>

                            <ui:Button Grid.Column="4" x:Name="ExportEventLogButton" Content="Export CSV"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Width="120" Click="ExportEventLogButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="EventLogLevelFilterComboBox" Margin="0,0,20,0"
                                      SelectedIndex="0" SelectionChanged="EventLogLevelFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All levels"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="Error"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Information"/>
                                <ComboBoxItem Content="Verbose"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Method" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" x:Name="EventLogMethodFilterComboBox" Margin="0,0,20,0"
                                      SelectedIndex="0" SelectionChanged="EventLogMethodFilterComboBox_SelectionChanged"/>

                            <TextBlock Grid.Column="4" Text="Type" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="5" x:Name="EventLogTypeFilterComboBox"
                                      SelectedIndex="0" SelectionChanged="EventLogTypeFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All types"/>
                                <ComboBoxItem Content="Response"/>
                                <ComboBoxItem Content="Payload"/>
                                <ComboBoxItem Content="Exception"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="EventLogStatusTextBlock" Margin="0,10,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <DataGrid Grid.Row="3" x:Name="EventLogDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  PreviewMouseLeftButtonUp="EventLogDataGrid_PreviewMouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="160"/>
                                <DataGridTemplateColumn Header="Level" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding LevelBackground}" CornerRadius="4"
                                                    Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Level}" Foreground="{Binding LevelForeground}"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70"/>
                                <DataGridTextColumn Header="Method" Binding="{Binding MethodName}" Width="160"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding MessageType}" Width="90"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding MessageSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Command">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <ui:Button DockPanel.Dock="Right" x:Name="RunCommandButton" Content="Run" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Play24}" Width="100" Click="RunCommandButton_Click"/>
                            <ui:TextBox x:Name="CommandInputBox" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                        PlaceholderText="publish --project MyApp --version 1.0.0.R0001B"
                                        KeyDown="CommandInputBox_KeyDown"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Type any PublishTool command, e.g. publish --project MyApp --version 1.0.0.R0001B, or add-project --name MyApp --csproj C:\src\MyApp\MyApp.csproj --pubxml FolderProfile --iis-host C:\inetpub\wwwroot\MyApp"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" x:Name="SettingsCategoryListBox" Margin="0,0,16,0"
                                 SelectionChanged="SettingsCategoryListBox_SelectionChanged">
                            <ListBoxItem Content="General" IsSelected="True"/>
                            <ListBoxItem Content="Projects"/>
                            <ListBoxItem Content="Remote Build Hosting"/>
                            <ListBoxItem Content="Dev Server Relays"/>
                        </ListBox>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid>

                        <StackPanel x:Name="SettingsGeneralPanel">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Builds root" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="BuildsRootTextBox" Margin="0,6,6,6"/>
                                <ui:Button Grid.Row="0" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                           Width="100" Click="BrowseBuildsRootButton_Click"/>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                                    <ui:Button x:Name="SaveSettingsButton" Content="Save" Appearance="Primary"
                                               Icon="{ui:SymbolIcon Save24}" Width="110" Click="SaveSettingsButton_Click"/>
                                    <ui:Button x:Name="OpenBuildsRootButton" Content="Open in Explorer" Icon="{ui:SymbolIcon Open24}"
                                               Width="150" Margin="10,0,0,0" Click="OpenBuildsRootButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <ui:ToggleSwitch x:Name="DarkModeToggle"
                                             Content="Dark mode" Margin="0,20,0,0" Checked="DarkModeToggle_Toggled" Unchecked="DarkModeToggle_Toggled"/>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <TextBlock Text="Accent color" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#0078D4" Cursor="Hand"
                                        Tag="Blue" ToolTip="Blue" MouseLeftButtonUp="AccentSwatch_Click"/>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#8764B8" Cursor="Hand"
                                        Tag="Purple" ToolTip="Purple" Margin="10,0,0,0" MouseLeftButtonUp="AccentSwatch_Click"/>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#107C10" Cursor="Hand"
                                        Tag="Green" ToolTip="Green" Margin="10,0,0,0" MouseLeftButtonUp="AccentSwatch_Click"/>
                            </StackPanel>

                            <ui:ToggleSwitch x:Name="StartOnStartupToggle"
                                             Content="Start on Windows startup" Margin="0,20,0,0"
                                             Checked="StartOnStartupToggle_Toggled" Unchecked="StartOnStartupToggle_Toggled"
                                             ToolTip="Closing the window minimizes PublishTool to the system tray instead of exiting -- right-click the tray icon to exit fully."/>
                        </StackPanel>

                        <StackPanel x:Name="SettingsProjectsPanel" Visibility="Collapsed">
                            <TextBlock Text="Project configs" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Share project setup with teammates without hand re-entering every field. You choose which projects go in an export, and which imported projects are allowed to overwrite what's already here."/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="ExportProjectsButton" Content="Export projects..." Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Width="160" Click="ExportProjectsButton_Click"/>
                                <ui:Button x:Name="ImportProjectsButton" Content="Import projects..." Icon="{ui:SymbolIcon ArrowUpload24}"
                                           Width="160" Margin="10,0,0,0" Click="ImportProjectsButton_Click"/>
                            </StackPanel>

                            <TextBlock Text="Deployment Environments" FontWeight="SemiBold" Margin="0,24,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Named deploy targets (e.g. Staging, Production) offered when configuring a project's local/dev-server deploy targets, or picking one to publish to. Local to this machine, unless &quot;Use dev server for projects&quot; on the Remote Build Hosting page is on -- then shared with your whole team."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" x:Name="EnvironmentsListBox" Height="120"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="150">
                                    <ui:Button Content="Make default" Icon="{ui:SymbolIcon Star24}" HorizontalAlignment="Stretch" Click="MakeDefaultEnvironmentButton_Click"/>
                                    <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="RemoveEnvironmentButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="NewEnvironmentNameTextBox" PlaceholderText="e.g. Staging" Margin="0,0,6,0"/>
                                <ui:Button Grid.Column="1" Content="Add" Icon="{ui:SymbolIcon Add24}" Width="100" Click="AddEnvironmentButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="SettingsRemoteHostingPanel" Visibility="Collapsed">
                            <TextBlock Text="Remote Build Hosting" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Publish straight to a dev server this machine has no filesystem access to. Configure it here -- whether a given project's builds actually go there is a per-project setting in the Projects tab, not a per-publish choice."/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="RemoteHostingUrlTextBox" Margin="0,6"
                                            PlaceholderText="https://devserver.internal"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="API key" VerticalAlignment="Center"/>
                                <ui:PasswordBox Grid.Row="1" Grid.Column="1" x:Name="RemoteHostingApiKeyBox" Margin="0,6"
                                                 PlaceholderText="(leave blank to keep the saved key)"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button x:Name="SaveRemoteHostingButton" Content="Save" Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}" Width="110" Click="SaveRemoteHostingButton_Click"/>
                                <ui:Button x:Name="TestRemoteHostingButton" Content="Test connection" Icon="{ui:SymbolIcon Globe24}"
                                           Width="150" Margin="10,0,0,0" Click="TestRemoteHostingButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RemoteHostingStatusTextBlock" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <ui:ToggleSwitch x:Name="UseRemoteModeToggle" Content="Use dev server for projects + IIS tab (all GUI users share this)"
                                             Margin="0,14,0,0" Checked="UseRemoteModeToggle_Toggled" Unchecked="UseRemoteModeToggle_Toggled"
                                             ToolTip="When on, the Projects tab and IIS tab read from/manage the dev server above instead of this machine. Independent of whether any individual project uploads/deploys its builds there (set per-project in the Projects tab)."/>
                        </StackPanel>

                        <StackPanel x:Name="SettingsRelaysPanel" Visibility="Collapsed">
                            <TextBlock Text="Dev Server Relays" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="If your network (e.g. a VPN that doesn't route to the dev server's subnet) can't reach the dev server directly, save a colleague's already-connected machine here as a relay -- &quot;Use&quot; switches the URL on the Remote Build Hosting page to theirs with one click and tests it right away. Same API key either way; only the URL changes."/>

                            <DataGrid x:Name="RemoteHostingRelaysDataGrid" MinHeight="220" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                                    <DataGridTemplateColumn Header="Actions" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Content="Use" Width="60" Click="UseRemoteHostingRelayButton_Click"/>
                                                    <ui:Button Content="Test" Width="60" Margin="6,0,0,0" Click="TestRemoteHostingRelayButton_Click"/>
                                                    <ui:Button Content="Remove" Width="75" Margin="6,0,0,0" Click="RemoveRemoteHostingRelayButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="NewRelayNameTextBox" PlaceholderText="e.g. John's machine" Margin="0,0,6,0"/>
                                <ui:TextBox Grid.Column="1" x:Name="NewRelayUrlTextBox" PlaceholderText="http://&lt;colleague-VPN-IP&gt;:8080" Margin="0,0,6,0"/>
                                <ui:Button Grid.Column="2" Content="Add relay" Icon="{ui:SymbolIcon Add24}" Width="120" Click="AddRemoteHostingRelayButton_Click"/>
                            </Grid>

                            <TextBlock Text="Host a Relay (this machine)" FontWeight="SemiBold" Margin="0,24,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="If this machine is in-office and already connected to the dev server, host a relay here so a colleague who can't reach it directly can go through you instead. Starting/stopping asks for one Administrator confirmation (it sets up a netsh port forward + firewall rule) -- no manual command prompt needed."/>

                            <DataGrid x:Name="HostedRelaysDataGrid" MinHeight="200" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Listen Port" Binding="{Binding ListenPort}" Width="100"/>
                                    <DataGridTextColumn Header="Forwards to" Binding="{Binding ForwardsTo}" Width="*"/>
                                    <DataGridTextColumn Header="IIS Site(s)" Binding="{Binding MatchedSites}" Width="*"/>
                                    <DataGridTemplateColumn Header="Actions" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="Stop" Width="80" Click="StopHostedRelayButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Width="100" Click="RefreshHostedRelaysButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="HostedRelaysHintTextBlock" Margin="0,0,0,10" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="NewRelayListenPortTextBox" PlaceholderText="8080" Margin="0,0,6,0"/>
                                <ui:TextBox Grid.Column="1" x:Name="NewRelayConnectAddressTextBox" PlaceholderText="dev server host, e.g. devserver.internal" Margin="0,0,6,0"/>
                                <ui:TextBox Grid.Column="2" x:Name="NewRelayConnectPortTextBox" PlaceholderText="port" Margin="0,0,6,0"/>
                                <ui:Button Grid.Column="3" Content="Start Relay" Icon="{ui:SymbolIcon Play24}" Width="130" Click="StartHostedRelayButton_Click"/>
                            </Grid>

                            <TextBlock Text="IIS Sites on Dev Server" FontWeight="SemiBold" Margin="0,24,0,6"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Relay every port the dev server's IIS sites use, in one go, forwarding to the same address as the Remote Build Hosting URL above. One relay per port covers every site on it (host-header or not), so a colleague reaches any of them at http://&lt;this machine's address&gt;:&lt;site's port&gt;. Both buttons ask for one Administrator confirmation total, no matter how many ports are involved."/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Relay All IIS Sites" Icon="{ui:SymbolIcon Play24}" Width="160" Click="RelayAllIisSitesButton_Click"/>
                                <ui:Button Content="Stop All IIS Site Relays" Icon="{ui:SymbolIcon Stop24}" Width="180" Margin="10,0,0,0" Click="StopAllIisSiteRelaysButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Audit Logs">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RefreshCombinedAuditButton" Content="Refresh"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RefreshCombinedAuditButton_Click"/>
                            <TextBlock Text="Every action recorded across every tab -- Projects, Firewall, and IIS"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DockPanel>

                        <ui:TextBox Grid.Row="1" x:Name="CombinedAuditSearchTextBox" Margin="0,0,0,10"
                                    PlaceholderText="Search category, subject, action, details, by..."
                                    TextChanged="CombinedAuditSearchTextBox_TextChanged"/>

                        <DataGrid Grid.Row="2" x:Name="CombinedAuditDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding PerformedAtUtc, Converter={StaticResource UtcToPhTimeConverter}}" Width="160"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                <DataGridTextColumn Header="By" Binding="{Binding PerformedBy}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Help">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <ui:Button DockPanel.Dock="Right" x:Name="CheckForUpdatesButton" Content="Check for updates"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="160" Click="CheckForUpdatesButton_Click"/>
                            <TextBlock x:Name="AppVersionTextBlock" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" x:Name="RecheckDependenciesButton" Content="Recheck"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Width="110" Click="RecheckDependenciesButton_Click"/>
                            <TextBlock Text="Dependencies" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="External tools PublishTool relies on. MSBuild is required for Publish (.NET projects); IIS (appcmd.exe) is required for auto-creating sites and the IIS tab; Node.js/npm is required for Angular and Android projects; Java (JDK) and the Android SDK are additionally required for Android projects."/>

                        <DataGrid Grid.Row="3" x:Name="DependenciesDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dependency" Binding="{Binding Name}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusTextBlock" Text="Idle"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Width="160" Margin="0,0,10,0"/>
                <ui:Button DockPanel.Dock="Right" x:Name="ToggleOutputButton" Content="Hide output"
                           Icon="{ui:SymbolIcon PanelRight24}" Width="130" Click="ToggleOutputButton_Click"/>
                <ProgressBar x:Name="PublishProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0"/>
            </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" x:Name="OutputSplitter" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"/>

            <Border Grid.Column="2" x:Name="OutputPanel" Margin="6,0,0,0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Output" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" x:Name="OutputLogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

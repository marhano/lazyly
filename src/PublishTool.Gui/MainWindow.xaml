<Window x:Class="PublishTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PublishTool.Gui"
        mc:Ignorable="d"
        Title="PublishTool" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabControl">
            <TabItem Header="Publish">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Project"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectComboBox" Margin="0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Version"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="VersionTextBox" Margin="0,4"/>

                    <Button Grid.Row="2" Grid.Column="1" x:Name="PublishButton" Content="Publish"
                            HorizontalAlignment="Left" Width="120" Margin="0,10" Click="PublishButton_Click"/>
                    <Button Grid.Row="3" Grid.Column="1" x:Name="RefreshProjectsButton" Content="Refresh projects"
                            HorizontalAlignment="Left" Width="120" Click="RefreshProjectsButton_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Add Project">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Name"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NewProjectNameTextBox" Margin="0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content=".csproj path"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewProjectCsprojTextBox" Margin="0,4,6,4"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Width="80" Click="BrowseCsproj_Click"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Publish profile"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="NewProjectPubxmlTextBox" Margin="0,4,6,4"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Width="80" Click="BrowsePubxml_Click"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="AssemblyInfo.cs&#10;(optional)"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="NewProjectAssemblyInfoTextBox" Margin="0,4,6,4"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Width="80" Click="BrowseAssemblyInfo_Click"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="IIS host folder"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="NewProjectIisHostTextBox" Margin="0,4,6,4"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Width="80" Click="BrowseIisHost_Click"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Extra publish&#10;targets (optional)"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NewProjectExtraTargetsTextBox" Margin="0,4"
                             ToolTip="Semicolon-separated MSBuild targets to force during publish, for packages whose own .targets don't hook into this toolset -- e.g. CollectSQLiteInteropFiles"/>

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="SaveProjectButton" Content="Save project" Width="120" Click="SaveProjectButton_Click"/>
                        <Button x:Name="NewProjectButton" Content="Clear form" Width="100" Margin="10,0,0,0" Click="NewProjectButton_Click"/>
                        <Button x:Name="RemoveProjectButton" Content="Remove selected" Width="120" Margin="10,0,0,0" Click="RemoveProjectButton_Click"/>
                    </StackPanel>

                    <Label Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Content="Registered projects (click to edit):"/>
                    <ListBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" x:Name="RegisteredProjectsListBox"
                             DisplayMemberPath="Name" SelectionChanged="RegisteredProjectsListBox_SelectionChanged"/>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Builds root"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="BuildsRootTextBox" Margin="0,4,6,4"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Width="80" Click="BrowseBuildsRootButton_Click"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="SaveSettingsButton" Content="Save" Width="100" Click="SaveSettingsButton_Click"/>
                        <Button x:Name="OpenBuildsRootButton" Content="Open in Explorer" Width="130" Margin="10,0,0,0" Click="OpenBuildsRootButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Command">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" x:Name="RunCommandButton" Content="Run" Width="80" Click="RunCommandButton_Click"/>
                        <TextBox x:Name="CommandInputBox" Margin="0,0,10,0" VerticalContentAlignment="Center" KeyDown="CommandInputBox_KeyDown"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Type any PublishTool command, e.g. publish --project MyApp --version 1.0.0.R0001B, or add-project --name MyApp --csproj C:\src\MyApp\MyApp.csproj --pubxml FolderProfile --iis-host C:\inetpub\wwwroot\MyApp"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" x:Name="StatusTextBlock" Text="Idle"
                       VerticalAlignment="Center" Width="160" Margin="0,0,10,0"/>
            <ProgressBar x:Name="PublishProgressBar" Height="18" IsIndeterminate="True" Visibility="Collapsed"/>
        </DockPanel>

        <GroupBox Grid.Row="2" Header="Output" Margin="0,10,0,0">
            <TextBox x:Name="OutputLogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/>
        </GroupBox>
    </Grid>
</Window>

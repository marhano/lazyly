<ui:FluentWindow x:Class="PublishTool.Gui.ExportProjectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Export Project Configs" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose which projects to export. Saved passwords are never included -- they only decrypt for the user who saved them."
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="Select all" Click="SelectAllButton_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Select none" Click="SelectNoneButton_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="ProjectsListBox" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Export..." Appearance="Primary" Click="ExportButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

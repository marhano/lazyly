<ui:FluentWindow x:Class="PublishTool.Gui.SetAppPoolIdentityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Set application pool identity" Height="230" Width="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PoolNameTextBlock" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Identity" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="2" x:Name="IdentityTypeComboBox" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="LocalSystem/LocalService/NetworkService are built-in Windows service accounts with real privilege differences -- only pick one higher than ApplicationPoolIdentity if the site actually needs it."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Apply" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
